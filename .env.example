# --- AI ---
# Get this from https://console.anthropic.com (Anthropic API key for the app's own LLM calls)
ANTHROPIC_API_KEY=

# --- GitHub ingestion ---
# Get this from https://github.com/settings/tokens (a Personal Access Token, read-only "repo" scope is enough for public/private commit history)
GITHUB_TOKEN=
# Comma-separated list of "owner/repo" to pull commit history from
GITHUB_REPOS=

# --- Database ---
# Local dev can use sqlite:///./undrift.db ; production should be a real Postgres URL (e.g. from Supabase or Neon)
DATABASE_URL=sqlite:///./undrift.db

# --- App auth (simple shared-secret gate since this stays private) ---
APP_USERNAME=
APP_PASSWORD=
