# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- AI ---
# From https://console.anthropic.com -- used to classify each commit's skill.
ANTHROPIC_API_KEY=
# Optional; defaults to claude-haiku-4-5. Commits are classified in batches
# against a fixed skill vocabulary -- an easy task where Haiku matches Opus's
# labels for a fraction of the price. Any Claude model works here.
ANTHROPIC_MODEL=claude-haiku-4-5
# Commits per classification call. Batching amortises the system prompt, which
# is most of the cost of classifying one commit on its own.
TAGGER_BATCH_SIZE=25
# Spend ceiling: the most commits any single refresh will classify. Leftovers
# are picked up by the next run.
MAX_COMMITS_PER_TAG_RUN=600

# --- GitHub ingestion ---
# From https://github.com/settings/tokens
# Use a FINE-GRAINED token with only "Contents: Read-only" and
# "Metadata: Read-only". Undrift only ever issues GET requests; a classic
# token with full `repo` scope grants far more than this app needs.
GITHUB_TOKEN=
# Optional. Comma-separated "owner/repo" list to pin exactly what is tracked.
# Leave empty to auto-discover your most recently pushed repositories.
GITHUB_REPOS=
# How many repos to ingest per profile.
MAX_REPOS=6
# Ceiling on commits stored per repo -- the main lever on how much history a
# first sync pulls in.
MAX_COMMITS_PER_REPO=20
# Only ingest commits newer than this many days.
COMMIT_LOOKBACK_DAYS=730

# --- Profiles ---
# Undrift tracks several GitHub users at once. The token owner is always
# tracked. Listing extra PUBLIC usernames here seeds them as sample profiles,
# flagged as samples in the UI so their work isn't presented as your own.
# Leave empty to track only yourself.
SAMPLE_PROFILES=

# --- Database ---
# SQLite locally; a Postgres URL in production (Neon or Supabase free tier).
# `postgres://` and `postgresql://` URLs are rewritten to the psycopg driver
# automatically, so paste whatever your provider gives you.
DATABASE_URL=sqlite:///./undrift.db

# --- Auth (protects every route except /health) ---
# Required. The API returns 503 if these are unset rather than serving openly.
APP_USERNAME=
APP_PASSWORD=

# --- Frontend / CORS ---
# Origins allowed to call the API. Local Vite dev server by default; in
# production set this to your Vercel URL.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Decay algorithm ---
# Days for one commit's weight to halve. Lower = skills fade faster.
DECAY_HALF_LIFE_DAYS=60

# --- Scheduling ---
# Hours between in-process APScheduler refreshes.
REFRESH_INTERVAL_HOURS=12
# Set false on hosts that sleep when idle (Render free tier) and let the
# GitHub Actions cron drive refreshes instead.
ENABLE_SCHEDULER=true
