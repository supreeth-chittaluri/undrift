# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- AI ---
# From https://console.anthropic.com -- used to classify each commit's skill.
ANTHROPIC_API_KEY=
# Optional; defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# --- GitHub ingestion ---
# From https://github.com/settings/tokens
# Use a FINE-GRAINED token with only "Contents: Read-only" and
# "Metadata: Read-only". Undrift only ever issues GET requests; a classic
# token with full `repo` scope grants far more than this app needs.
GITHUB_TOKEN=
# Optional. Comma-separated "owner/repo" list to pin exactly what is tracked.
# Leave empty to auto-discover your most recently pushed repositories.
GITHUB_REPOS=
# How many repos to ingest when auto-discovering.
MAX_REPOS=10
# Only ingest commits newer than this many days.
COMMIT_LOOKBACK_DAYS=730

# --- Database ---
# SQLite locally; a Postgres URL in production (Neon or Supabase free tier).
# `postgres://` and `postgresql://` URLs are rewritten to the psycopg driver
# automatically, so paste whatever your provider gives you.
DATABASE_URL=sqlite:///./undrift.db

# --- Auth (protects every route except /health) ---
# Required. The API returns 503 if these are unset rather than serving openly.
APP_USERNAME=
APP_PASSWORD=

# --- Frontend / CORS ---
# Origins allowed to call the API. Local Vite dev server by default; in
# production set this to your Vercel URL.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Decay algorithm ---
# Days for one commit's weight to halve. Lower = skills fade faster.
DECAY_HALF_LIFE_DAYS=60

# --- Scheduling ---
# Hours between in-process APScheduler refreshes.
REFRESH_INTERVAL_HOURS=12
# Set false on hosts that sleep when idle (Render free tier) and let the
# GitHub Actions cron drive refreshes instead.
ENABLE_SCHEDULER=true
